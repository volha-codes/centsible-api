// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id              String @id @default(cuid())
  name            String
  currency        String
  startingBalance Float
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
}

enum CategoryType {
  income
  expense
}

model Category {
  id     String       @id @default(cuid())
  name   String
  icon   String
  color  String
  type   CategoryType
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([name, type, userId])
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  firstName      String
  hashedPassword String
  createdAt      DateTime   @default(now())
  accounts       Account[]
  categories     Category[]
}
